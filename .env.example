DATABASE_URL=postgres://tenant:tenant@localhost:5432/tenant_saas
BIND_ADDR=127.0.0.1:3001
RUST_LOG=info
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_TTL_SECS=3600
PUBLIC_RATE_LIMIT_PER_MIN=60
# 只有部署在可信任的反向代理後面才設為 true
TRUST_PROXY=false
# 以 cookie 登入時,允許送出寫入請求的額外網頁來源(逗號分隔);PUBLIC_BASE_URL 的來源自動允許
# ALLOWED_ORIGINS=https://admin.example.com
MAIL_FROM=預約系統 <noreply@localhost>
# 本機可用 docker compose 的 mailpit:smtp://127.0.0.1:1025(信件看 http://127.0.0.1:8025)
SMTP_URL=
PUBLIC_BASE_URL=http://localhost:3001
WORKER_ENABLED=true
WORKER_POLL_SECS=5
# 設定後才開放 GET /metrics(需帶 Authorization: Bearer <token>),至少 16 字元
METRICS_TOKEN=
# json 或留空(人類可讀)
LOG_FORMAT=
# 正式環境設為 production:資料庫帳號過大(超級使用者等)會拒絕啟動,且預設不自動套用 migration
APP_ENV=
AUTO_MIGRATE=
# 套用 migration 用的帳號(有建表 / 建角色權限),`tenant-saas migrate` 使用;未設定則退回 DATABASE_URL
MIGRATION_DATABASE_URL=
# 註冊 / 登入每個來源每分鐘的上限(防暴力破解)
AUTH_RATE_LIMIT_PER_MIN=10
# 每位收件者每小時最多收幾封信,跨店家(預設 6)
# MAX_MAILS_PER_RECIPIENT_PER_HOUR=6
# 每位使用者最多能擁有幾家店(預設 5)
# MAX_SHOPS_PER_USER=5
