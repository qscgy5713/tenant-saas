# 複製成 deploy/.env.prod 並填值(.gitignore 已排除,不要提交)
APP_VERSION=1.0.0
DATABASE_URL=postgres://tenant_runtime:密碼@DB_HOST/tenant_saas?sslmode=require
MIGRATION_DATABASE_URL=postgres://tenant_migrator:密碼@DB_HOST/tenant_saas?sslmode=require
JWT_SECRET=請用 openssl rand -hex 32 產生
SMTP_URL=smtps://帳號:密碼@smtp.example.com:465
MAIL_FROM=預約系統 <noreply@example.com>
PUBLIC_BASE_URL=https://book.example.com
# 至少 16 字元;monitoring profile 要把同一個值寫進 deploy/secrets/metrics_token
METRICS_TOKEN=
# 稽核日誌保留天數(0 = 永久保留;其他值不得少於 90)
AUDIT_RETENTION_DAYS=730
# Stripe(全部留空 = 不啟用線上訂閱)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
